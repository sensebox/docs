{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@site/*": ["./*"],
      "$libs": ["src/libs"],
      "$libs/*": ["src/libs/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "**/node_modules", "dist"]
}
